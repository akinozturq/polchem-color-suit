# ============================================================================
# Polchem Color Suit — .gitignore
# ============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions & legacy third-party binaries
backend/bin/
*.exe
*.dll
*.pyd

# SQLite & local runtime databases (auto-generated on startup by database.py)
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Distribution / packaging / virtual environments
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
env/
venv/
ENV/
env.bak/
venv.bak/
.venv/

# Node & Frontend dependencies & caches
node_modules/
.npm/
.eslintcache
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.map

# Secrets & Environment variables
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
secrets.*
credentials.*

# Operating System & IDE artifacts
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
